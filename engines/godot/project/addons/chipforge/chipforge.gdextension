[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/chipforge/bin/libchipforge_godot.so"
linux.release.x86_64 = "res://addons/chipforge/bin/libchipforge_godot.so"
linux.debug.arm64 = "res://addons/chipforge/bin/libchipforge_godot.arm64.so"
linux.release.arm64 = "res://addons/chipforge/bin/libchipforge_godot.arm64.so"
windows.debug.x86_64 = "res://addons/chipforge/bin/chipforge_godot.dll"
windows.release.x86_64 = "res://addons/chipforge/bin/chipforge_godot.dll"
macos.debug = "res://addons/chipforge/bin/libchipforge_godot.dylib"
macos.release = "res://addons/chipforge/bin/libchipforge_godot.dylib"
