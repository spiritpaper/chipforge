  "type": "module",
  "scripts": {
    "wasm": "cargo build --profile wasm --target wasm32-unknown-unknown -p chipcore --manifest-path ../Cargo.toml && cp ../target/wasm32-unknown-unknown/wasm/chipcore.wasm src/audio/chipcore.wasm",
    "predev": "pnpm wasm",
    "dev": "vite",
    "prebuild": "pnpm wasm",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "export-templates": "tsx scripts/export-templates.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "puppeteer-core": "^25.12.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tauri-apps/api": "^2.12.2",
    "@tensorflow/tfjs": "^3.21.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "onnxruntime-web": "^1.30.0",
    "wasm-media-encoders": "^0.7.0"
  }
