{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path ../core/Cargo.toml && cp ../core/target/wasm32-unknown-unknown/release/chipcore.wasm src/audio/chipcore.wasm",
    "predev": "pnpm wasm",
    "dev": "vite",
    "prebuild": "pnpm wasm",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0"
  }
}
