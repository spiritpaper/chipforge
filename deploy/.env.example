# Copy to .env and adjust.

# --- Trying it on this computer -------------------------------------------------
# Open http://localhost:8080. Sign-in links are printed in `docker compose logs api`.
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080

# --- On a server with a domain ---------------------------------------------------
# Point the domain's DNS at the server, then:
# CHIPFORGE_SITE=music.example.com
# APP_ORIGIN=https://music.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Email for sign-in links (otherwise they go to the log) --------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=change-me
# MAIL_FROM=ChipForge <no-reply@example.com>
