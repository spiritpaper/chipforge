# CHIPFORGE_SITE is ":80" for plain HTTP, or a domain (music.example.com) for automatic
# HTTPS with a Let's Encrypt certificate.
{$CHIPFORGE_SITE::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed build files never change; the page and service worker must stay fresh.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh path / /index.html /sw.js
	header @fresh Cache-Control "no-cache"
	header {
		# Cross-origin isolation: lets Convert → Split into parts use every core.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
